  componentId   String
  imageType     String    @default("MAIN") @db.VarChar(20)
  svgContent    String    @db.Text
  widthMm       Int?
  heightMm      Int?
  depthMm       Int?
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  component     Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId, imageType])
}

model ComponentPricing {
  id              String    @id @default(cuid())
  componentId     String
  supplierName    String    @db.VarChar(160)
  supplierSku     String?   @db.VarChar(120)
  unitPrice       Decimal   @db.Decimal(18, 4)
  currency        String    @default("BRL") @db.VarChar(3)
  quantityMin     Int       @default(1)
  validFrom       DateTime  @default(now())
  validTo         DateTime?
  source          String?   @db.VarChar(120)
  lastUpdatedAt   DateTime  @default(now())

