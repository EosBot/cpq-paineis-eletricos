model PurchaseOrder {
  id              String             @id @default(cuid())
  tenantId        String
  orderNumber     String             @db.VarChar(120)
  supplierId      String
  status          PurchaseOrderStatus @default(RASCUNHO)
  totalAmount     Decimal            @default(0) @db.Decimal(18, 4)
  expectedDelivery DateTime?
  receivedAt      DateTime?
  notes           String?            @db.VarChar(500)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  items           PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(18, 4)
  quantityReceived Decimal      @default(0) @db.Decimal(18, 4)
  unitCost        Decimal       @db.Decimal(18, 4)
  total           Decimal       @db.Decimal(18, 4)
  createdAt       DateTime      @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([tenantId, purchaseOrderId])
}

enum FiscalDocumentType {
  NFE
  NFCE
  NFSE
  INVOICE
}

enum FiscalDocumentStatus {
  RASCUNHO
  PROCESSANDO
  AUTORIZADO
  CANCELADO
  CORRIGIDO
}

enum FiscalRegime {
  NORMAL
  SIMPLES_NACIONAL
}

enum FiscalCST {
  CST_00
  CST_10
  CST_20
  CST_30
  CST_40
  CST_41
  CST_50
  CST_51
  CST_60
  CST_70
  CST_90
  CST_101
  CST_102
  CST_103
  CST_201
  CST_202
  CST_203
  CST_300
  CST_400
  CST_500
  CST_900
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinancialTransactionStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum ReconciliationStatus {
  NAO_CONCILIADO
  CONCILIADO
  DIVERGENTE
}

enum MountingType {
  DIN_RAIL
  PLATE
  FLANGE
  DIRECT
  PLUG_IN
}

enum PoleCount {
  ONE_P
  TWO_P
  THREE_P
  FOUR_P
}

enum ClimateZone {
  COASTAL
  AMAZON
  SEMI_ARID
  SOUTHERN_HIGHLANDS
  PLATEAU
}

enum RuleType {
  VALIDATION
  PRICING
  COMPATIBILITY
  SIZING
  THERMAL
  CLEARANCE
  BUSINESS
}

enum RuleSeverity {
  ERROR
  WARNING
  INFO
}

enum TemplateComplexity {
  SIMPLE
  MEDIUM
  COMPLEX
}

model FiscalSeries {
  id              String          @id @default(cuid())
  tenantId        String
  code            String          @db.VarChar(20)
  documentType    FiscalDocumentType
  nextNumber      Int             @default(1)
  environment     String          @default("2") @db.VarChar(1)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents       FiscalDocument[]

  @@unique([tenantId, code])
  @@index([tenantId, documentType])
}

model FiscalDocument {
  id                  String              @id @default(cuid())
  tenantId            String
  seriesId            String?
  documentType        FiscalDocumentType
  status              FiscalDocumentStatus @default(RASCUNHO)
  seriesCode          String?             @db.VarChar(20)
  documentNumber      Int?
  chaveAcesso         String?             @unique @db.VarChar(44)
  customerId          String?
  customerName        String?             @db.VarChar(160)
  customerTaxId       String?             @db.VarChar(20)
  customerEmail       String?             @db.VarChar(320)
  customerAddress     Json?
  issuerName          String?             @db.VarChar(160)
  issuerTaxId         String?             @db.VarChar(20)
  issuerAddress       Json?
  totalAmount         Decimal             @default(0) @db.Decimal(18, 4)
  discountAmount      Decimal             @default(0) @db.Decimal(18, 4)
  taxAmount           Decimal             @default(0) @db.Decimal(18, 4)
  netAmount           Decimal             @default(0) @db.Decimal(18, 4)
  xmlContent          String?             @db.Text
  xmlProtocol         String?             @db.VarChar(44)
  qrCodeUrl           String?             @db.VarChar(500)
  pdfUrl              String?             @db.VarChar(500)
  issueDate           DateTime?
  cancellationDate    DateTime?
  correctionLetter    String?             @db.Text
  gateway             String              @default("SELF") @db.VarChar(40)
  notes               String?             @db.VarChar(500)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series              FiscalSeries?       @relation(fields: [seriesId], references: [id])
  items               FiscalItem[]

  @@unique([tenantId, documentType, seriesCode, documentNumber])
  @@index([tenantId, status])
  @@index([chaveAcesso])
}

model FiscalItem {
  id                  String    @id @default(cuid())
  tenantId            String
  fiscalDocumentId    String
  productId           String?
  itemNumber          Int
  description         String    @db.VarChar(200)
  ncmCode             String?   @db.VarChar(20)
  cfopCode            String    @db.VarChar(10)
  unit                String    @default("UN") @db.VarChar(10)
  quantity            Decimal   @db.Decimal(18, 4)
  unitPrice           Decimal   @db.Decimal(18, 4)
  totalPrice          Decimal   @db.Decimal(18, 4)
  discount            Decimal   @default(0) @db.Decimal(18, 4)
  icmsCst             String?   @db.VarChar(10)
  icmsBase            Decimal?  @db.Decimal(18, 4)
  icmsRate            Decimal?  @db.Decimal(18, 4)
  icmsValue           Decimal?  @db.Decimal(18, 4)
  ipiRate             Decimal?  @db.Decimal(18, 4)
  ipiValue            Decimal?  @db.Decimal(18, 4)
  pisCst              String?   @db.VarChar(10)
  pisBase             Decimal?  @db.Decimal(18, 4)
  pisRate             Decimal?  @db.Decimal(18, 4)
  pisValue            Decimal?  @db.Decimal(18, 4)
  cofinsCst           String?   @db.VarChar(10)
  cofinsBase          Decimal?  @db.Decimal(18, 4)
  cofinsRate          Decimal?  @db.Decimal(18, 4)
  cofinsValue         Decimal?  @db.Decimal(18, 4)
  issRate             Decimal?  @db.Decimal(18, 4)
  issValue            Decimal?  @db.Decimal(18, 4)
  createdAt           DateTime  @default(now())

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalDocument      FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  @@index([tenantId, fiscalDocumentId])
}

model TaxRate {
  id              String          @id @default(cuid())
  tenantId        String
  code            String          @db.VarChar(20)
  description     String          @db.VarChar(120)
  taxType         String          @db.VarChar(20)
  rate            Decimal         @db.Decimal(18, 4)
  state           String?         @db.VarChar(2)
  ncmCode         String?         @db.VarChar(20)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code, state])
  @@index([tenantId, taxType])
}

model FinancialAccount {
  id              String    @id @default(cuid())
  tenantId        String
  code            String    @db.VarChar(40)
  name            String    @db.VarChar(120)
  type            AccountType
  parentAccountId String?
  level           Int       @default(1)
  isAnalytical    Boolean   @default(true)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentAccount   FinancialAccount? @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   FinancialAccount[] @relation("AccountHierarchy")

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

model FinancialTransaction {
  id              String    @id @default(cuid())
  tenantId        String
  accountId       String
  referenceType   String?   @db.VarChar(60)
  referenceId     String?
  type            String    @db.VarChar(20)
  amount          Decimal   @db.Decimal(18, 4)
  direction       String    @db.VarChar(10)
  status          FinancialTransactionStatus @default(PENDENTE)
  dueDate         DateTime?
  paidDate        DateTime?
  description     String?   @db.VarChar(300)
  counterpartName String?   @db.VarChar(160)
  counterpartTaxId String?  @db.VarChar(20)
  paymentMethod   String?   @db.VarChar(40)
  notes           String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([referenceType, referenceId])
}

model BankAccount {
  id              String    @id @default(cuid())
  tenantId        String
  name            String    @db.VarChar(120)
  bankCode        String?   @db.VarChar(10)
  agency          String?   @db.VarChar(20)
  accountNumber   String?   @db.VarChar(20)
  balance         Decimal   @default(0) @db.Decimal(18, 4)
  lastSyncAt      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bankCode, agency, accountNumber])
  @@index([tenantId])

  bankTransactions BankTransaction[]
}

model BankTransaction {
  id              String    @id @default(cuid())
  tenantId        String
  bankAccountId   String
  transactionDate DateTime
  description     String?   @db.VarChar(300)
  amount          Decimal   @db.Decimal(18, 4)
  direction       String    @db.VarChar(10)
  fitid           String?   @db.VarChar(120)
  status          ReconciliationStatus @default(NAO_CONCILIADO)
  matchedTransactionId String?
  notes           String?   @db.VarChar(300)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bankAccountId, fitid])
  @@index([tenantId, bankAccountId, status])
}

model TenantPrivacyConfig {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  dpoName                 String?  @db.VarChar(160)
  dpoEmail                String?  @db.VarChar(320)
  dpoPhone                String?  @db.VarChar(40)
  privacyPolicyUrl        String?  @db.VarChar(500)
  privacyPolicyUpdatedAt  DateTime?
  dataRetentionDays       Int      @default(365)
  termsOfUseUrl           String?  @db.VarChar(500)
  allowDataSharing        Boolean  @default(false)
  requireExplicitConsent  Boolean  @default(true)
  lgpdComplianceEnabled   Boolean  @default(true)
  legalBasisDefault       String   @default("LEGITIMATE_INTEREST")
  anonymizeOnDeletion     Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id                String    @id @default(cuid())
  tenantId          String
  userId            String
  purpose           String    @db.VarChar(200)
  purposeDescription String   @db.VarChar(500)
  legalBasis        String    @db.VarChar(40)
  granted           Boolean   @default(false)
  grantedAt         DateTime?
  revokedAt         DateTime?
  expiresAt         DateTime?
  ipAddress         String?   @db.VarChar(64)
  userAgent         String?   @db.VarChar(500)
  consentVersion    String    @default("1.0") @db.VarChar(10)
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, purpose])
}

model DataSubjectRequest {
  id                String    @id @default(cuid())
  tenantId          String
  userId            String
  requestType       String    @db.VarChar(40)
  status            String    @default("PENDING") @db.VarChar(20)
  description       String?   @db.VarChar(500)
  requestedAt       DateTime  @default(now())
  fulfilledAt       DateTime?
  responseNotes     String?   @db.VarChar(500)
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, status])
}

model PrivacyAuditLog {
