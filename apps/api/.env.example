# Exemplo de variáveis de ambiente (copie para .env e ajuste)
DATABASE_URL="postgresql://cpq:cpq@localhost:5432/cpq"

# JWT — em produção use segredos fortes e distintos
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Porta da API
PORT=3000

# CORS — origens do frontend separadas por vírgula.
# Ex.: http://localhost:5173,https://app.paineisdemo.com
# Deixe vazio para desabilitar CORS (fail-closed).
CORS_ORIGIN="http://localhost:5173"

# Browserbase (onboarding 2026-07-16)
# BROWSERBASE_API_KEY="bb_live_..."  # defina no .env local (não commitar)
# BROWSERBASE_PROJECT_ID="d6fd191a-4c4c-4fe1-a4ef-02e4b15b235e"

# Browserbase (browser automation / E2E) — veja README.md
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""

# Stripe (SaaS subscriptions)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUCCESS_URL="http://localhost:5173/billing/success"
STRIPE_CANCEL_URL="http://localhost:5173/billing/cancel"
STRIPE_RETURN_URL="http://localhost:5173/admin"

# Platform domain (for custom domain verification)
PLATFORM_DOMAIN="platform.cpqpaineis.com.br"
