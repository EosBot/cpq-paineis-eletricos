@startuml C4-Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-Context/main/C4_Context.puml

title System Context Diagram — CPQ Marketplace

Person(customer, "Customer", "End user who browses and buys products")
Person(seller, "Seller (Merchant)", "Manages storefront and ERP")
Person(admin, "Platform Admin", "Manages the marketplace platform")

System(marketplace, "CPQ Marketplace", "Multi-tenant marketplace for electrical panels and components.\nCustomers browse, configure (CPQ), and buy.\nSellers manage products, orders, and ERP.")
System_Ext(payment, "Payment Gateway", "Future: Process payments (Stripe/Pagar.me)")
System_Ext(email, "Email Service", "Future: Transactional emails")
System_Ext(storage, "Object Storage", "Future: Product images, documents")

Rel(customer, marketplace, "Browses products, configures panels, places orders", "HTTPS")
Rel(seller, marketplace, "Manages products, fulfills orders, views analytics", "HTTPS")
Rel(admin, marketplace, "Manages tenants, users, platform settings", "HTTPS")
Rel(marketplace, payment, "Processes payments", "API")
Rel(marketplace, email, "Sends notifications", "API")
Rel(marketplace, storage, "Stores/retrieves files", "API")

@enduml
